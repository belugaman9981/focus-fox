{
  "manifest_version": 3,
  "name": "FocusFox — Study Helper & Social Blocker",
  "version": "1.4.0",
  "description": "Block distracting social media and get AI-powered homework help with your own DeepSeek API key.",
  "permissions": ["storage", "declarativeNetRequest", "alarms", "notifications", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFox"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["blocked.html", "styles.css"],
    "matches": ["<all_urls>"]
  }]
}
